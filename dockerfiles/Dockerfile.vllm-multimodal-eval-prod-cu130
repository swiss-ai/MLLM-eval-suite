FROM docker.io/nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MAX_JOBS=8
ARG CUDA_VERSION_PATH=cu130
ARG PYTHON_VERSION=3.12
ARG VLLM_VERSION=0.19.0
ARG VLLM_MAIN_CUDA_VERSION=13.0
ARG VLMEVALKIT_BRANCH=apertus-1p5-eval
ARG LMMS_EVAL_BRANCH=apertus-1p5-eval

# GH200 = Hopper SM90a
ENV TORCH_CUDA_ARCH_LIST="9.0a" \
    MAX_JOBS="${MAX_JOBS}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    VLLM_USE_PRECOMPILED=1 \
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
    VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION}" \
    VLLM_PRECOMPILED_WHEEL_VARIANT="${CUDA_VERSION_PATH}"

# Keep host NVIDIA driver libraries first to avoid CUDA Error 803
# from loading cuda-compat stubs in /usr/local/cuda/compat.
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /opt

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bash-completion ca-certificates ccache curl git less vim-tiny \
    build-essential cmake ninja-build pkgconf \
    libgl1 libglib2.0-0 \
    libibverbs-dev libnuma1 libnuma-dev \
    ffmpeg \
    openjdk-17-jre-headless \
    python3 python3-dev python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/*
RUN java -version
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:/root/.local/bin:${PATH}"

RUN python --version && python -m pip --version && uv --version

RUN python -m pip install --upgrade \
    pip \
    wheel \
    "setuptools>=77.0.3,<81.0.0"

RUN uv pip install --python /opt/venv/bin/python \
    --index-url https://download.pytorch.org/whl/${CUDA_VERSION_PATH} \
    torch==2.10.0 \
    torchvision==0.25.0 \
    torchaudio==2.10.0

RUN uv pip install --python /opt/venv/bin/python \
    "packaging>=24.2" \
    ninja \
    "cmake>=3.26.1" \
    "setuptools-scm>=8" \
    "jinja2>=3.1.6" \
    regex \
    build \
    "protobuf>=5.29.6,<6.0.0dev" \
    "ray[default]"

RUN python - <<'PY'
import torch
print("Torch:", torch.__version__)
print("Torch CUDA:", torch.version.cuda)
PY

# CUDA 13 compatibility: expose cuDNN/NCCL headers where extension builds can find them.
RUN CUDNN_DIR=$(dirname "$(find /usr -name cudnn.h -print -quit)") && \
    find "${CUDNN_DIR}" -maxdepth 1 -name 'cudnn*.h' -exec ln -sf {} /opt/venv/include/ \; && \
    NCCL_H=$(find /opt/venv/lib/python${PYTHON_VERSION}/site-packages -path '*/nvidia/nccl/include/nccl.h' -print -quit) && \
    if [ -n "${NCCL_H}" ]; then ln -sf "${NCCL_H}" /opt/venv/include/nccl.h; fi

WORKDIR /workspace

RUN git clone https://github.com/swiss-ai/vllm.git /workspace/vllm && \
    cd /workspace/vllm && \
    git checkout apertus-lmms-eval && echo "vLLM commit: $(git rev-parse HEAD)"
RUN git clone https://github.com/baaivision/Emu3.5.git /workspace/Emu3.5
RUN git clone https://github.com/swiss-ai/benchmark-audio-tokenizer.git /workspace/benchmark-audio-tokenizer && \
    cd /workspace/benchmark-audio-tokenizer && \
    git submodule update --init --recursive
RUN git clone https://github.com/swiss-ai/lmms-eval.git /workspace/lmms-eval && \
    cd /workspace/lmms-eval && \
    git checkout "${LMMS_EVAL_BRANCH}" && \
    echo "lmms-eval branch: ${LMMS_EVAL_BRANCH}" && \
    echo "lmms-eval commit: $(git rev-parse HEAD)"
RUN git clone https://github.com/swiss-ai/VLMEvalKit.git /workspace/VLMEvalKit && \
    cd /workspace/VLMEvalKit && \
    git checkout "${VLMEVALKIT_BRANCH}" && \
    echo "VLMEvalKit branch: ${VLMEVALKIT_BRANCH}" && \
    echo "VLMEvalKit commit: $(git rev-parse HEAD)"

ENV VLLM_REPO=/workspace/vllm \
    EMU35=/workspace/Emu3.5 \
    WAVTOKENIZER=/workspace/benchmark-audio-tokenizer/src/repos/wavtokenizer \
    VLLM_APERTUS_AUDIO_TOKENIZER_CODEBASE=/workspace/benchmark-audio-tokenizer \
    PYTHONPATH=/workspace/VLMEvalKit:/workspace/vllm:/workspace/benchmark-audio-tokenizer:${PYTHONPATH} \
    LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/venv/lib/python3.12/site-packages/torch/lib \
    VLLM_APERTUS_EMU35_CODEBASE=/workspace/Emu3.5

RUN set -eu; \
    export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"; \
    mkdir -p "${UV_CACHE_DIR}"; \
    export VLLM_PRECOMPILED_WHEEL_VARIANT="${VLLM_PRECOMPILED_WHEEL_VARIANT:-cu130}"; \
    export VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION:-13.0}"; \
    export VLLM_PRECOMPILED_WHEEL_LOCATION="${VLLM_PRECOMPILED_WHEEL_LOCATION:-https://github.com/vllm-project/vllm/releases/download/v${VLLM_VERSION}/vllm-${VLLM_VERSION}+cu130-cp38-abi3-manylinux_2_35_aarch64.whl}"; \
    if [ -z "${VLLM_PRECOMPILED_WHEEL_COMMIT:-}" ] && VLLM_GIT_COMMIT="$(git -C "${VLLM_REPO}" rev-parse HEAD 2>/dev/null)"; then \
      export VLLM_PRECOMPILED_WHEEL_COMMIT="${VLLM_GIT_COMMIT}"; \
    fi; \
    cd "${VLLM_REPO}"; \
    VLLM_USE_PRECOMPILED=1 uv pip install \
      --python /opt/venv/bin/python \
      --reinstall-package vllm \
      --no-build-isolation \
      --editable . \
      --torch-backend=auto

RUN /opt/venv/bin/python - <<'PY'
import torch

print(f"Torch runtime: {torch.__version__} (CUDA {torch.version.cuda})")
try:
    import vllm._C  # noqa: F401
except Exception as exc:
    if "libcuda.so.1" in str(exc):
        print("Skipping strict vllm._C import check during image build: libcuda.so.1 is unavailable in build environment.")
    else:
        raise
else:
    print("vLLM native extension import check passed.")
PY

RUN cd /workspace/lmms-eval && \
    uv pip install --python /opt/venv/bin/python \
    --no-build-isolation \
    --editable . \
    ".[all]"

RUN uv pip install --python /opt/venv/bin/python \
    scipy \
    ruff \
    tblib \
    pytest \
    ipdb \
    jieba \
    distance \
    apted \
    lxml \
    zss \
    sacrebleu \
    Polygon3 \
    matplotlib \
    spacy \
    editdistance \
    nltk \
    lmdb \
    latex2sympy2_extended \
    pymupdf

# Dependencies needed by the Apertus VLMEvalKit wrapper/image.
RUN python - <<'PY'
from pathlib import Path
import re

skip = {
    "antlr4-python3-runtime",
    "cd-fvd",
    "decord",
    "dotenv",
    "torch",
    "torchaudio",
    "torchvision",
}
lines = []
for line in Path("/workspace/VLMEvalKit/requirements.txt").read_text().splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    name = re.split(r"[<>=!~; \[]", stripped, maxsplit=1)[0].lower()
    if name in skip:
        continue
    lines.append(stripped)
Path("/tmp/vlmevalkit-image-requirements.txt").write_text("\n".join(lines) + "\n")
print("Installing", len(lines), "VLMEvalKit dependency entries")
PY

RUN uv pip install --python /opt/venv/bin/python \
      --no-build-isolation \
      -r /tmp/vlmevalkit-image-requirements.txt && \
    uv pip install --python /opt/venv/bin/python \
      --no-deps \
      --editable /workspace/VLMEvalKit && \
    uv pip install --python /opt/venv/bin/python --reinstall \
      "protobuf>=5.29.6,<6.0.0dev" \
      antlr4-python3-runtime==4.9.3 && \
    uv pip install --python /opt/venv/bin/python \
      "scipy>=1.10" \
      "pyyaml>=6.0" \
      "soundfile>=0.12" \
      "einops>=0.6.1" \
      "beautifulsoup4>=4.12"

RUN /opt/venv/bin/python -c "import nltk; nltk.download('wordnet', download_dir='/usr/share/nltk_data', quiet=True)"

RUN uv pip uninstall torchcodec || true && \
    uv pip install -U pybind11 cmake ninja && \
    cd /workspace && \
    rm -rf torchcodec && \
    git clone --branch v0.10.0 https://github.com/pytorch/torchcodec.git && \
    cd /workspace/torchcodec && \
    I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 \
    BUILD_AGAINST_ALL_FFMPEG_FROM_S3=1 \
    CMAKE_PREFIX_PATH="/opt/venv/lib/python3.12/site-packages/pybind11/share/cmake/pybind11:${CMAKE_PREFIX_PATH:-}" \
    uv pip install -v --no-build-isolation .
# Marker used by Apertus VLMEvalKit Slurm scripts to skip legacy runtime
# overlays for bs4/nltk/wordnet.
RUN echo "apertus-lmms-eval-vlmeval-cu130 $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /etc/apertus_image_version

RUN set -eu; \
    /opt/venv/bin/python -m pip check > /tmp/pip-check.log 2>&1 || true; \
    /opt/venv/bin/python - <<'PY'
from pathlib import Path

allowed = (
    "vlmeval 0.1.0 requires cd-fvd, which is not installed.",
    "vlmeval 0.1.0 requires decord, which is not installed.",
    "vlmeval 0.1.0 requires dotenv, which is not installed.",
    "vlmeval 0.1.0 has requirement antlr4-python3-runtime==4.11.1, but you have antlr4-python3-runtime 4.9.3.",
    "latex2sympy2 1.9.1 has requirement antlr4-python3-runtime==4.7.2, but you have antlr4-python3-runtime 4.9.3.",
    "nvidia-cusparselt-cu13 0.8.0 is not supported on this platform",
)

lines = [
    line.strip()
    for line in Path("/tmp/pip-check.log").read_text().splitlines()
    if line.strip()
]
unexpected = [line for line in lines if line not in allowed]
if unexpected:
    print("Unexpected pip check failures:")
    print("\n".join(unexpected))
    raise SystemExit(1)
if lines:
    print("Ignored expected pip check metadata issues:")
    print("\n".join(lines))
else:
    print("pip check passed")
PY
RUN /opt/venv/bin/python - <<'PY'
import cv2
import lmms_eval
import torch
import torchvision
import transformers
import vllm
from google.protobuf import __version__ as protobuf_version
from src.audio_tokenizers.implementations.wavtokenizer import WavTokenizer40
from vlmeval.config import supported_VLM
from vlmeval.dataset import SUPPORTED_DATASETS

assert torch.__version__.startswith("2.10.0"), torch.__version__
assert str(torch.version.cuda).startswith("13."), torch.version.cuda
assert "Apertus-1p5-8B" in supported_VLM
assert "3DSRBench" in SUPPORTED_DATASETS
assert WavTokenizer40.name == "wavtokenizer-40"

print("dependency preflight passed")
print("torch:", torch.__version__, torch.version.cuda)
print("torchvision:", torchvision.__version__)
print("transformers:", transformers.__version__)
print("vllm:", getattr(vllm, "__version__", "unknown"))
print("protobuf:", protobuf_version)
print("cv2:", cv2.__version__)
print("lmms_eval:", getattr(lmms_eval, "__version__", "unknown"))
PY
# ENV CUDA_HOME=/usr/local/cuda
# RUN uv pip install --python /opt/venv/bin/python --no-build-isolation \
#       git+https://github.com/nickjbrowning/XIELU
# Install Node.js 22.x
# Install modern Node.js (includes npm)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/*

RUN node --version && npm --version
RUN npm install -g @openai/codex
RUN codex --version
RUN /opt/venv/bin/python - <<'PY'
import lmms_eval
import vllm
from vlmeval.config import supported_VLM
from vlmeval.dataset import SUPPORTED_DATASETS
from src.audio_tokenizers.implementations.wavtokenizer import WavTokenizer40

print("lmms_eval:", getattr(lmms_eval, "__version__", "unknown"))
print("vllm:", getattr(vllm, "__version__", "unknown"))
assert "Apertus-1p5-8B" in supported_VLM
assert "3DSRBench" in SUPPORTED_DATASETS
print("wavtokenizer:", WavTokenizer40.name)
PY

RUN printf '%s\n' \
    'Production CUDA 13 image with local vLLM source, lmms-eval, and VLMEvalKit Apertus dependencies.' \
    'Included paths:' \
    '  /workspace/VLMEvalKit' \
    '  /workspace/vllm' \
    '  /workspace/Emu3.5 (EMU35)' \
    '  /workspace/benchmark-audio-tokenizer (VLLM_APERTUS_AUDIO_TOKENIZER_CODEBASE)' \
    '  /workspace/benchmark-audio-tokenizer/src/repos/wavtokenizer (WAVTOKENIZER)' \
    > /etc/motd

ARG BUILD_STAMP=unknown
RUN echo "${BUILD_STAMP}" > /etc/apertus_image_version
