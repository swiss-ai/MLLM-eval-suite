FROM docker.io/nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MAX_JOBS=8
ARG CUDA_VERSION_PATH=cu130
ARG PYTHON_VERSION=3.12
ARG VLLM_MAIN_CUDA_VERSION=13.0
# Eval runs upstream vLLM: image tokenization is harness-side, so the engine is
# a commodity, and the fork lagged upstream twice (Apertus mm plugin, Gemma4
# per-layer head_dim) in ways that broke evaluation.
ARG VLLM_REPO_URL=https://github.com/vllm-project/vllm.git
ARG VLLM_SRC_BRANCH=main
# One source of truth for which vLLM this image is: the source checkout and the
# precompiled wheel must be the same commit or the tree and the binary disagree.
# VLLM_WHEEL_VERSION must match that commit's published wheel; verify with
#   curl -s https://wheels.vllm.ai/<commit>/vllm/ | grep aarch64
ARG VLLM_SRC_COMMIT=324f452f640015e9616b5ad5615fae6c25eb6353
ARG TRANSFORMERS_BRANCH=add-apertus1p5
ARG TRANSFORMERS_COMMIT=3596b056f73c7f44849c042cc02413c747636eab
ARG VLMEVALKIT_BRANCH=main
ARG LMMS_EVAL_BRANCH=main
ARG VLLM_WHEEL_VERSION=0.26.1rc1.dev687

# GH200 = Hopper SM90a
ENV TORCH_CUDA_ARCH_LIST="9.0a" \
    MAX_JOBS="${MAX_JOBS}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    UV_HTTP_RETRIES=5 \
    VLLM_USE_PRECOMPILED=1 \
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
    VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION}" \
    VLLM_PRECOMPILED_WHEEL_VARIANT="${CUDA_VERSION_PATH}"

# Keep host NVIDIA driver libraries first to avoid CUDA Error 803
# from loading cuda-compat stubs in /usr/local/cuda/compat.
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /opt

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bash-completion ca-certificates ccache curl git less vim-tiny \
    build-essential cmake ninja-build pkgconf \
    libgl1 libglib2.0-0 \
    libibverbs-dev libnuma1 libnuma-dev \
    ffmpeg \
    openjdk-17-jre-headless \
    python3 python3-dev python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/*

RUN java -version
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install "uv==0.11.30"

ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:/root/.local/bin:${PATH}"

RUN python --version && python -m pip --version && uv --version

RUN python -m pip install --upgrade \
    pip \
    wheel \
    "setuptools>=77.0.3,<81.0.0"

RUN uv pip install --python /opt/venv/bin/python \
    --index-url https://download.pytorch.org/whl/${CUDA_VERSION_PATH} \
    torch==2.13.0 \
    torchvision==0.28.0 \
    torchaudio==2.11.0

RUN uv pip install --python /opt/venv/bin/python \
    "packaging>=24.2" \
    ninja \
    "cmake>=3.26.1" \
    "setuptools-scm>=8" \
    setuptools_rust \
    "jinja2>=3.1.6" \
    regex \
    build \
    "protobuf>=5.29.6,<6.0.0dev" \
    "ray[default]"


# CUDA 13 compatibility: expose cuDNN/NCCL headers where extension builds can find them.
RUN CUDNN_DIR=$(dirname "$(find /usr -name cudnn.h -print -quit)") && \
    find "${CUDNN_DIR}" -maxdepth 1 -name 'cudnn*.h' -exec ln -sf {} /opt/venv/include/ \; && \
    NCCL_H=$(find /opt/venv/lib/python${PYTHON_VERSION}/site-packages -path '*/nvidia/nccl/include/nccl.h' -print -quit) && \
    if [ -n "${NCCL_H}" ]; then ln -sf "${NCCL_H}" /opt/venv/include/nccl.h; fi

WORKDIR /workspace

RUN git clone "${VLLM_REPO_URL}" /workspace/vllm && \
    cd /workspace/vllm && \
    git fetch origin "${VLLM_SRC_COMMIT}" && \
    git checkout "${VLLM_SRC_COMMIT}" && \
    echo "vLLM branch: ${VLLM_SRC_BRANCH}" && \
    echo "vLLM commit: $(git rev-parse HEAD)"
RUN git clone --branch "${TRANSFORMERS_BRANCH}" https://github.com/swiss-ai/transformers.git /workspace/transformers && \
    cd /workspace/transformers && \
    git fetch origin "${TRANSFORMERS_COMMIT}" && \
    git checkout "${TRANSFORMERS_COMMIT}" && \
    echo "Transformers branch: ${TRANSFORMERS_BRANCH}" && \
    echo "Transformers commit: $(git rev-parse HEAD)"
RUN git clone https://github.com/swiss-ai/lmms-eval.git /workspace/lmms-eval && \
    cd /workspace/lmms-eval && \
    git checkout "${LMMS_EVAL_BRANCH}" && \
    echo "lmms-eval branch: ${LMMS_EVAL_BRANCH}" && \
    echo "lmms-eval commit: $(git rev-parse HEAD)"
RUN git clone https://github.com/swiss-ai/VLMEvalKit.git /workspace/VLMEvalKit && \
    cd /workspace/VLMEvalKit && \
    git checkout "${VLMEVALKIT_BRANCH}" && \
    echo "VLMEvalKit branch: ${VLMEVALKIT_BRANCH}" && \
    echo "VLMEvalKit commit: $(git rev-parse HEAD)"


ENV LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/venv/lib/python3.12/site-packages/torch/lib


WORKDIR /workspace/vllm
# Install vLLM  from source, with no dependencies to avoid compiling any sub-dependencies.
RUN set -eu; \
    export VLLM_PRECOMPILED_WHEEL_VARIANT="${VLLM_PRECOMPILED_WHEEL_VARIANT:-cu130}"; \
    export VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION:-13.0}"; \
    WHEEL_ARCH="aarch64"; \
    export VLLM_PRECOMPILED_WHEEL_LOCATION="${VLLM_PRECOMPILED_WHEEL_LOCATION:-https://wheels.vllm.ai/${VLLM_SRC_COMMIT}/vllm-${VLLM_WHEEL_VERSION}%2Bg$(echo ${VLLM_SRC_COMMIT} | cut -c1-9)-cp38-abi3-manylinux_2_28_${WHEEL_ARCH}.whl}"; \
    export VLLM_PRECOMPILED_WHEEL_COMMIT="${VLLM_PRECOMPILED_WHEEL_COMMIT:-${VLLM_SRC_COMMIT}}"; \
    VLLM_USE_PRECOMPILED=1 uv pip install \
    --python /opt/venv/bin/python \
    --reinstall-package vllm \
    --no-build-isolation ".[audio]" \
    --torch-backend="${VLLM_PRECOMPILED_WHEEL_VARIANT}";
    # torch-backend must stay pinned to the image's CUDA variant: `auto`
    # resolves against the BUILD node's driver, which can pull a newer-CUDA
    # torch while the earlier-pinned torchaudio stays cu130 — torchaudio then
    # refuses to import at runtime (mismatched CUDA versions).

# Install the Transformers fork from source, with no dependencies to avoid compiling any sub-dependencies.
RUN uv pip install --python /opt/venv/bin/python \
    --no-deps \
    /workspace/transformers

# Install flashinfer precompiled cubin and Python wheel
RUN uv pip uninstall flashinfer-cubin flashinfer-python || true && \
    uv pip install flashinfer-python && \
    uv pip install flashinfer-cubin --index-url https://flashinfer.ai/whl

# Install lmms-eval from source
RUN cd /workspace/lmms-eval && \
    uv pip install --python /opt/venv/bin/python \
    --no-build-isolation \
    --editable . \
    ".[all]"

#install Additional lmms-eval dependencies
RUN uv pip install --python /opt/venv/bin/python \
    scipy \
    ruff \
    tblib \
    pytest \
    ipdb \
    jieba \
    distance \
    apted \
    lxml \
    zss \
    sacrebleu \
    Polygon3 \
    matplotlib \
    spacy \
    editdistance \
    nltk \
    lmdb \
    latex2sympy2_extended \
    pymupdf

# Dependencies needed by the Apertus VLMEvalKit wrapper/image.
RUN python - <<'PY'
from pathlib import Path
import re

skip = {
    "antlr4-python3-runtime",
    "cd-fvd",
    "decord",
    "dotenv",
    "torch",
    "torchaudio",
    "torchvision",
}
lines = []
for line in Path("/workspace/VLMEvalKit/requirements.txt").read_text().splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    name = re.split(r"[<>=!~; \[]", stripped, maxsplit=1)[0].lower()
    if name in skip:
        continue
    lines.append(stripped)
Path("/tmp/vlmevalkit-image-requirements.txt").write_text("\n".join(lines) + "\n")
print("Installing", len(lines), "VLMEvalKit dependency entries")
PY

# Install VLMEvalKit from source
RUN uv pip install --python /opt/venv/bin/python \
      --no-build-isolation \
      -r /tmp/vlmevalkit-image-requirements.txt && \
    uv pip install --python /opt/venv/bin/python --reinstall \
      "protobuf>=5.29.6,<6.0.0dev" \
      antlr4-python3-runtime==4.9.3 && \
    uv pip install --python /opt/venv/bin/python \
      "scipy>=1.10" \
      "pyyaml>=6.0" \
      "soundfile>=0.12" \
      "einops>=0.6.1" \
      "beautifulsoup4>=4.12"

# Download NLTK
RUN /opt/venv/bin/python -c "import nltk; nltk.download('wordnet', download_dir='/usr/share/nltk_data', quiet=True)"

# install torchcodec from source because of arm64 issues with precompiled wheels.
RUN uv pip uninstall torchcodec || true && \
    uv pip install -U pybind11 cmake ninja && \
    cd /workspace && \
    rm -rf torchcodec && \
    git clone --branch v0.15.0 https://github.com/pytorch/torchcodec.git && \
    cd /workspace/torchcodec && \
    I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 \
    BUILD_AGAINST_ALL_FFMPEG_FROM_S3=1 \
    CMAKE_PREFIX_PATH="/opt/venv/lib/python3.12/site-packages/pybind11/share/cmake/pybind11:${CMAKE_PREFIX_PATH:-}" \
    uv pip install -v --no-build-isolation .

# lm-eval-harness dependencies; the harness itself runs from the suite
# submodule on PYTHONPATH, same contract as the other two. math-verify goes in
# --no-deps: its real deps (latex2sympy2_extended, sympy) are already present,
# and resolving it normally would move the antlr4 pin VLMEvalKit relies on.
# latex2sympy2_extended is pinned to the exact version math-verify==0.9.0
# requires; langdetect/immutabledict serve ifeval (in text_full.txt).
# emoji/syllapy serve shared/ifbench_verifiers; func_timeout serves
# OmniDocBench and mdpbench. datasets and pyarrow arrive transitively and are
# pinned because releases on 2026-07-28 and 2026-08-10 changed in-memory
# dataset fingerprinting mid-campaign and broke a benchmark; the build fails
# below if they ever drift from what the harnesses were validated against.
RUN uv pip install --python /opt/venv/bin/python \
    rouge-score \
    sqlitedict \
    word2number \
    langdetect \
    immutabledict \
    emoji \
    syllapy \
    func_timeout \
    datasets==5.0.1 \
    pyarrow==25.0.1 \
    latex2sympy2_extended==1.11.0 && \
    uv pip install --python /opt/venv/bin/python --no-deps math-verify==0.9.0 && \
    /opt/venv/bin/python -c "import datasets, pyarrow, emoji, syllapy, func_timeout; \
assert datasets.__version__ == '5.0.1', datasets.__version__; \
assert pyarrow.__version__ == '25.0.1', pyarrow.__version__" 

# The image ships engine + dependencies only; harness code comes from the suite
# checkouts prepended to PYTHONPATH at job time. Removing the build trees makes
# a missing checkout fail loudly instead of silently running image-frozen code.
RUN uv pip uninstall --python /opt/venv/bin/python lmms_eval && \
    rm -rf /workspace/vllm /workspace/transformers /workspace/lmms-eval /workspace/VLMEvalKit /workspace/torchcodec
WORKDIR /workspace

# Advisory only: the venv holds three harnesses' dependency sets, and the
# resolver's consistency verdict belongs in the build log.
RUN uv pip check --python /opt/venv/bin/python || true

RUN printf '%s\n' \
    'Production CUDA 13 image: vLLM engine + lmms-eval/VLMEvalKit dependencies.' \
    'No harness code is baked in; jobs prepend the suite checkouts to PYTHONPATH.' \
    > /etc/motd

ARG BUILD_STAMP=unknown
RUN echo "${BUILD_STAMP}" > /etc/apertus_image_version
