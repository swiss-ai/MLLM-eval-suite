# Build context: dockerfiles/ (the launcher takes an immutable copy first).
ARG BASE_IMAGE=docker.io/nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04@sha256:c2621d98e7de80c2aec5eb8403b19c67454c8f5b0c929e8588fd3563c9b6558d
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG MAX_JOBS=8
ARG VLLM_SRC_COMMIT=51da0ca66c8065619c79e35dff97aa99aeaf5644
ARG VLLM_WHEEL_VERSION=0.28.1rc1.dev500
ARG VLLM_WHEEL_SHA256=569881fd0678d3cc6d54ba762743fdc6cce4489df9dcb36f439cf02e2f4ebc00
ARG TRANSFORMERS_COMMIT=3596b056f73c7f44849c042cc02413c747636eab
ARG LMMS_EVAL_COMMIT=84947e886131d912eac1aaab1c3dcb5908a35c92
# Dependency metadata is pinned; the current harness checkout is mounted at runtime.
ARG VLMEVALKIT_COMMIT=a8b0a456f2807831736e686e34b061c7ae8d5fd6
ARG TORCHCODEC_COMMIT=dc0f10da1fa2c807dedb7ed97de7b36d762b968b

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV TORCH_CUDA_ARCH_LIST="9.0a" \
    MAX_JOBS="${MAX_JOBS}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_HTTP_TIMEOUT=500 \
    UV_HTTP_RETRIES=5 \
    UV_LINK_MODE=copy \
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib \
    NLTK_DATA=/usr/share/nltk_data

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git ccache build-essential cmake ninja-build pkgconf \
    libgl1 libglib2.0-0 libibverbs-dev libnuma1 libnuma-dev ffmpeg \
    openjdk-17-jre-headless python3 python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install "uv==0.11.30"
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:${PATH}
COPY runtime-constraints.txt image_requirements.py /opt/apertus/
ENV UV_CONSTRAINT=/opt/apertus/runtime-constraints.txt

# Every later install obeys these engine pins, including the CUDA wheel variant.
# The launcher mounts a persistent uv download cache during the build.
RUN uv pip install --python /opt/venv/bin/python --torch-backend=cu130 \
    torch torchvision torchaudio \
    "setuptools>=77.0.3,<81" wheel "packaging>=24.2" ninja "cmake>=3.26.1" \
    "setuptools-scm>=8" setuptools_rust "jinja2>=3.1.6" pybind11 build

ENV LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/venv/lib/python3.12/site-packages/torch/lib

# Use official compiled vLLM binaries directly. There is no second source tree
# whose revision or Python code can disagree with the downloaded wheel.
# Keep temporary source checkouts and their deletion in this same layer.
RUN set -euo pipefail; \
    fetch_source() { \
      local repo="$1" revision="$2" destination="$3"; \
      git init -q "$destination"; \
      git -C "$destination" remote add origin "$repo"; \
      git -C "$destination" fetch --depth=1 origin "$revision"; \
      git -C "$destination" checkout --detach FETCH_HEAD; \
      test "$(git -C "$destination" rev-parse HEAD)" = "$revision"; \
    }; \
    fetch_source https://github.com/swiss-ai/transformers.git "$TRANSFORMERS_COMMIT" /tmp/transformers; \
    fetch_source https://github.com/swiss-ai/lmms-eval.git "$LMMS_EVAL_COMMIT" /tmp/lmms-eval; \
    fetch_source https://github.com/swiss-ai/VLMEvalKit.git "$VLMEVALKIT_COMMIT" /tmp/VLMEvalKit; \
    fetch_source https://github.com/pytorch/torchcodec.git "$TORCHCODEC_COMMIT" /tmp/torchcodec; \
    uv pip install --python /opt/venv/bin/python --no-deps /tmp/transformers; \
    wheel_url="https://wheels.vllm.ai/${VLLM_SRC_COMMIT}/vllm-${VLLM_WHEEL_VERSION}%2Bg${VLLM_SRC_COMMIT:0:9}-cp38-abi3-manylinux_2_28_aarch64.whl"; \
    python /opt/apertus/image_requirements.py /tmp/lmms-eval/pyproject.toml \
      /tmp/VLMEvalKit/requirements.txt /opt/apertus/harness-requirements.txt; \
    install_runtime() { \
    uv pip install --python /opt/venv/bin/python --torch-backend=cu130 \
      --extra-index-url https://flashinfer.ai/whl \
      "vllm[audio] @ ${wheel_url}#sha256=${VLLM_WHEEL_SHA256}" \
      -r /opt/apertus/harness-requirements.txt \
      "ray[default]" scipy ruff tblib pytest ipdb jieba distance apted lxml zss \
      sacrebleu Polygon3 matplotlib spacy editdistance nltk lmdb pymupdf \
      antlr4-python3-runtime protobuf "soundfile>=0.12" "beautifulsoup4>=4.12" \
      rouge-score sqlitedict word2number langdetect immutabledict emoji syllapy \
      func_timeout datasets pyarrow latex2sympy2_extended math-verify "$@"; \
    }; \
    install_runtime --dry-run; \
    I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 BUILD_AGAINST_ALL_FFMPEG_FROM_S3=1 \
      CMAKE_PREFIX_PATH=/opt/venv/lib/python3.12/site-packages/pybind11/share/cmake/pybind11 \
      uv pip install --python /opt/venv/bin/python --no-build-isolation /tmp/torchcodec; \
    install_runtime; \
    uv pip install --python /opt/venv/bin/python --no-deps latex2sympy2==1.9.1; \
    python -c "import nltk; assert nltk.download('wordnet', download_dir='/usr/share/nltk_data', quiet=True, raise_on_error=True)"; \
    printf '%s\n' "vllm=$VLLM_SRC_COMMIT" "vllm_wheel_sha256=$VLLM_WHEEL_SHA256" \
      "transformers=$TRANSFORMERS_COMMIT" "lmms_eval_dependencies=$LMMS_EVAL_COMMIT" \
      "vlmevalkit_dependencies=$VLMEVALKIT_COMMIT" "torchcodec=$TORCHCODEC_COMMIT" \
      > /opt/apertus/source-revisions.txt; \
    rm -rf /tmp/transformers /tmp/lmms-eval /tmp/VLMEvalKit /tmp/torchcodec

# Resolve all unexpected metadata conflicts as build failures. The sole legacy
# ANTLR exception is documented and matched precisely in verify_image.py.
COPY verify_image.py /opt/apertus/
RUN python /opt/apertus/verify_image.py && \
    uv pip freeze --python /opt/venv/bin/python > /opt/apertus/pip-freeze.txt && \
    dpkg-query -W > /opt/apertus/apt-packages.txt

WORKDIR /workspace
ARG BUILD_STAMP=unknown
RUN printf '%s\n' "$BUILD_STAMP" > /etc/apertus_image_version && \
    printf '%s\n' 'CUDA 13 Apertus evaluation runtime; harness code is mounted at job time.' > /etc/motd
LABEL org.opencontainers.image.revision="${VLLM_SRC_COMMIT}" \
      org.opencontainers.image.description="Apertus evaluation runtime with pinned vLLM ARM64 wheel"
